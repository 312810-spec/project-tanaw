# =============================================================================
# Project TANAW — environment template
# =============================================================================
# Copy this file to .env.local and fill in the local Supabase values.
#
# DEVELOPMENT TARGET IS LOCAL SUPABASE ONLY.
# The local stack runs on the 5532x port range (see supabase/config.toml):
#   API        http://127.0.0.1:55321
#   DB         127.0.0.1:55322
#   Studio     http://127.0.0.1:55323
#   SMTP/Inbox http://127.0.0.1:55324
#   Analytics  55327
#   Shadow DB  55320
#
# To obtain the local publishable key, run:  supabase status
# (the CLI prints it when the local stack is running).
#
# -----------------------------------------------------------------------------
# NEVER PLACE THESE IN .env.local OR ANY NEXT_PUBLIC_* VARIABLE:
#   - service_role key
#   - sb_secret_* values
#   - database password / SUPABASE_DB_URL
#   - hosted privileged credentials
# -----------------------------------------------------------------------------
# The publishable/anon key below is client-safe by design: it is the public
# API key for the LOCAL stack and carries only anon-role access enforced by RLS.
#
# Hosted Supabase (project qiqwfdmscbanetxfoqvp) is PROTECTED INFRASTRUCTURE.
# It is NOT a development target. Its credentials belong in Vercel
# environment variables for the deployed environment, never in this repo.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local-publishable-key-from-supabase-status>
